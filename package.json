{
	"name": "botbuzz",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"postinstall": "npm install --include=optional --os=linux --cpu=x64 sharp && npm approve-scripts sharp",
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint",
		"db:connect": "supabase login && supabase link",
		"db:migrate": "supabase db push --linked",
		"db:repair": "supabase migration repair 001 002 003 004 005 --status reverted --linked",
		"db:fix": "npm run db:repair && npm run db:migrate",
		"db:seed": "tsx --env-file=.env src/database/seed.ts",
		"db:init": "npm run db:connect && npm run db:migrate && npm run db:seed"
	},
	"dependencies": {
		"@ai-sdk/google": "^4.0.19",
		"@ai-sdk/react": "^4.0.38",
		"@ai-sdk/rsc": "^3.0.35",
		"@supabase/ssr": "^0.12.0",
		"@supabase/supabase-js": "^2.110.0",
		"ai": "^7.0.32",
		"dompurify": "^3.4.12",
		"marked": "^18.0.7",
		"next": "16.2.6",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"react-toastify": "^11.1.0",
		"sharp": "^0.35.3"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"dotenv": "^17.4.2",
		"eslint": "^9",
		"eslint-config-next": "16.2.6",
		"supabase": "^2.109.1",
		"tailwindcss": "^4",
		"tsx": "^4.23.0",
		"typescript": "^5"
	},
	"optionalDependencies": {
		"@img/sharp-linux-x64": "^0.35.3",
		"@img/sharp-linux-arm64": "^0.35.3",
		"@img/sharp-darwin-x64": "^0.35.3",
		"@img/sharp-darwin-arm64": "^0.35.3",
		"@img/sharp-win32-x64": "^0.35.3"
	}
}